# Gere uma chave aleatória para o ambiente local conforme o README.
DJANGO_SECRET_KEY='substitua-por-uma-chave-local'

# Desenvolvimento local. Na hospedagem, use False e os domínios autorizados.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Banco local no Docker Compose. Use uma senha própria antes de iniciar.
POSTGRES_DB=webhook_delivery
POSTGRES_USER=webhook_user
POSTGRES_PASSWORD='substitua-por-uma-senha-local'
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
# Somente para o PostgreSQL local. No Neon, use require.
POSTGRES_SSLMODE=disable
